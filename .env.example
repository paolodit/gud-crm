# Local development uses SQLite automatically when DATABASE_URL is absent.
DATA_BACKEND=sqlite
SQLITE_PATH=data/gud-crm.db
# Used only when creating a new SQLite/PostgreSQL workspace. Existing workspaces keep their saved model.
GUD_DEFAULT_MODEL=focused
GUD_INSTANCE_NAME=Local sales workspace
# Optional workbook shown in Settings. The file stays outside Git.
LOCAL_TRACKER_PATH=data/imports/outreach-tracker.xlsx

# PostgreSQL/VPS settings. Replace every placeholder in production, then set DATA_BACKEND=postgres.
# POSTGRES_PASSWORD and APP_URL are consumed by Docker Compose. Keep the same database
# password in DATABASE_URL when running migrations or the app directly from npm.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_URL=https://crm.example.com
DATABASE_URL=postgresql://gud:replace-with-a-long-random-database-password@localhost:5432/gud_crm
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://crm.example.com
NEXT_PUBLIC_APP_URL=https://crm.example.com
DEMO_MODE=false

# Used only when explicitly running `npm run db:seed`.
SEED_ORGANISATION_NAME=Example workspace
SEED_ADMIN_NAME=Workspace Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Optional account recovery email. When both are set in PostgreSQL mode,
# the sign-in screen exposes secure password reset through Resend.
RESEND_API_KEY=
AUTH_FROM_EMAIL=GUD CRM <crm@example.com>

# The local coach is deterministic and needs no API key. Set AI_PROVIDER=openai
# and provide OPENAI_API_KEY for model-generated coaching.
AI_ENABLED=true
AI_PROVIDER=local
AI_MODEL=gpt-5.6-luna
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT=6
OPENAI_API_KEY=

# Optional FreeMax research enrichment. Keys stay server-side and are never sent to the browser.
# Hunter's recurring free allowance is used first; Norbert's starter pool is fallback only.
HUNTER_API_KEY=
VOILA_NORBERT_API_KEY=
HUNTER_FREE_MONTHLY_LIMIT=50
NORBERT_FREE_LIFETIME_LIMIT=50
COMPANIES_HOUSE_API_KEY=
GOOGLE_MAPS_API_KEY=
